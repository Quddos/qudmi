.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Data & model artifacts (large, not meant for git) -- anchored to repo root so this doesn't
# also match src/qudmi/data/, which is a real Python package, not a data directory.
/data/
/checkpoints/
/runs/
*.onnx
# ...except the shipped model: the package is useless without it, and a git-URL
# install would otherwise silently do nothing.
!unity_plugin/Runtime/Model/*.onnx
*.pt
*.pth

# Unity
unity_plugin/**/Library/
unity_plugin/**/Temp/
unity_plugin/**/obj/
unity_plugin/**/*.csproj
unity_plugin/**/*.sln

# OS/editor
.DS_Store
.vscode/
.idea/
