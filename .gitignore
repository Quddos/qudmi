.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Data & model artifacts (large, not meant for git) -- anchored to repo root so this doesn't
# also match src/qudmi/data/, which is a real Python package, not a data directory.
/data/
/checkpoints/
/runs/
# Weights are distributed via Hugging Face / GitHub releases, deliberately NOT bundled in the
# Unity package: the package is MIT, the AMASS-trained weights are non-commercial, and shipping
# them together would misstate the package's licence. QudmiModelInstaller fetches them instead.
*.onnx
*.pt
*.pth

# Unity
unity_plugin/**/Library/
unity_plugin/**/Temp/
unity_plugin/**/obj/
unity_plugin/**/*.csproj
unity_plugin/**/*.sln

# OS/editor
.DS_Store
.vscode/
.idea/
